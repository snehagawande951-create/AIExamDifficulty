# Application Settings
PROJECT_NAME="AI-Based Question Paper Difficulty Analyzer"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server Configuration
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Security (Replace with strong random secrets in production)
# Generate with: openssl rand -hex 32
SECRET_KEY="development_secret_key_change_in_production_32_bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Option A: PostgreSQL
# DATABASE_URL="postgresql+psycopg2://postgres:yourpassword@localhost:5432/ai_exam_difficult"
# Option B: MySQL
# DATABASE_URL="mysql+pymysql://root:yourpassword@localhost:3306/ai_exam_difficult"
# Option C: Local SQLite (development fallback)
DATABASE_URL="sqlite:///./data/app.db"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage
UPLOAD_DIR="./backend/uploads"
REPORTS_DIR="./backend/reports"
MAX_UPLOAD_SIZE_BYTES=1073741824  # 1 GB limit (customizable)
