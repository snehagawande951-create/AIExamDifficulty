# ==============================================================================
# AI-Based Question Paper Difficulty Analyzer - Production Environment Template
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AI-Based Question Paper Difficulty Analyzer"
VERSION="1.0.0"

# Networking
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS="https://your-institution.edu,https://exams.your-institution.edu"

# Cryptographic Security
# CRITICAL: Generate a strong 64-character hex secret using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Standard persistent container volume):
DATABASE_URL=sqlite:///./data/app.db

# Or PostgreSQL (Production cluster recommendation):
# DATABASE_URL=postgresql+psycopg2://exam_user:SecurePostgresPassword!@postgres-db:5432/ai_exam_difficult

# File Storage & Limits
UPLOAD_DIR=/app/backend/uploads
REPORTS_DIR=/app/backend/reports
MAX_UPLOAD_SIZE_BYTES=1073741824 # 1 GB max document file size

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api/v1
