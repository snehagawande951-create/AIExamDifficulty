    "question_difficulty": {
      "classes": ["Easy", "Medium", "Hard"],
      "imbalance_ratio": 2.36,
      "continuous_score_range": [0.15, 0.94]
    }
  },
  "limitations_and_ethics": {
    "difficulty_construct": "Difficulty in this benchmark reflects an expert rubric where higher-order cognitive questions were designated Hard/Medium and factual recall Easy. Empirical student-perceived pass rate variations are investigated in qualitative error analysis.",
    "privacy": "All institutional identification numbers, student names, and proprietary examination marks schemes have been anonymized."
  }
