    "institutions": "Accredited University Mid-Term and Final Examination Archives",
    "language": "en"
  },
  "dataset_statistics": {
    "total_records": 570,
    "subjects_covered": [
      "Discrete Mathematics",
      "Software Engineering",
      "Engineering Physics",
      "Database Systems",
      "Data Structures",
      "Operating Systems",
      "Computer Networks",
      "Artificial Intelligence"
