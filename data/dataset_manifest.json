      "median": 6.0,
      "max": 15.0
    }
  },
  "splits": {
    "train": {
      "path": "data/processed/train.csv",
      "count": 399,
      "percentage": 70.0
    },
    "validation": {
      "path": "data/processed/val.csv",
      "count": 85,
      "percentage": 14.9
    },
    "test_held_out": {
      "path": "data/processed/test.csv",
      "count": 86,
      "percentage": 15.1
    }
  },
  "label_schema": {
    "blooms_taxonomy": {
      "classes": ["Remember", "Understand", "Apply", "Analyze", "Evaluate", "Create"],
